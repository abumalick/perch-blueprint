# Copy to deploy/agent.env and fill in. deploy/agent.env is gitignored.
# A strong random token, e.g. `openssl rand -hex 32`
PERCH_TOKEN=replace-with-openssl-rand-hex-32
# Unique per machine (e.g. "mac" or "mini")
PERCH_MACHINE_ID=mac
# Colon-separated project roots offered for new workspaces
PERCH_PROJECT_ROOTS=/Users/you/workspace
# Loopback only — tailscale serve provides the tailnet WSS
PERCH_HOST=127.0.0.1
PERCH_PORT=8787
